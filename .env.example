# DashScope (Qwen) — TEXT / storyboard chat only
DASHSCOPE_API_KEY=sk-你的key
QWEN_TEXT_MODEL=qwen-plus
QWEN_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Volcano Ark Seedream 4.0 — IMAGE generation (up to 10 reference images)
ARK_API_KEY=你的火山方舟key
SEEDREAM_MODEL=doubao-seedream-4-0-250828
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Max reference images forwarded to the image model per panel render (<=10)
RENDER_MAX_REFS=10

PORT=8080
DB_PATH=oh-my-commic.db
DATA_DIR=data

# ---- 用户管理 / 社区（注册走邀请码闸门）----
# 启动时按下面 env 播种管理员（空用户名=不播种）。用户名/密码非法则启动 fatal。
#   username: ^[a-z][a-z0-9_]{2,19}$   password: 8-64 位、含字母+数字、纯 ASCII
ADMIN_USERNAME=admin
ADMIN_PASSWORD=改成你的强口令Passw0rd
ADMIN_EMAIL=admin@example.com
# 全局邀请码：空 = 注册未开放（谁都注册不了）；缺省则启动随机生成并打日志 "邀请码: ..."
INVITE_CODE=换成你的邀请码
# 每个邀请码可注册多少人（默认 10）。轮换邀请码后名额重置；0 = 不限制
INVITE_MAX_USES=10
# 注册赠送积分（每次出图/漫画化扣 1，失败退还）
SIGNUP_CREDITS=100
